POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_detection

# true = bật consumer Kafka (Docker đầy đủ). false = chỉ API + DB (Render/Vercel không có broker).
ENABLE_KAFKA=true

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=transactions

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fraud_detection

SEND_INTERVAL=0.5
MAX_ROWS=5000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts
